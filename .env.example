# Meta access token with ads_management, ads_read, pages_show_list,
# pages_read_engagement and business_management. Use a System User token from
# Business Settings so it doesn't expire.
META_ACCESS_TOKEN=

# Graph / Marketing API version
META_API_VERSION=v26.0

PORT=3000
# Keep 127.0.0.1 unless you deploy it; if you expose it, set a password.
HOST=127.0.0.1
DASHBOARD_PASSWORD=
